 "sq": [
  {
   "_id": 18793,
   "ANSWER": "<p><br data-end=\"1381\" data-start=\"1378\" />\n<code data-end=\"1397\" data-start=\"1381\">pthread_join()</code> is used to <strong data-end=\"1440\" data-start=\"1409\">wait for a thread to finish</strong> its execution. It helps synchronize threads and ensures that the main thread doesn&rsquo;t terminate before child threads are done.</p>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO3",
    "PLO4"
   ],
   "QUESTION_DESC": "<h3 data-end=\"1366\" data-start=\"1299\"><strong data-end=\"1364\" data-start=\"1303\">What is the use of <code data-end=\"1343\" data-start=\"1327\">pthread_join()</code> in multithreading?</strong></h3>\n\n<p data-end=\"1566\" data-start=\"1367\">&nbsp;</p>\n",
   "SESSION_ID": 209,
   "TYPE": "sq",
   "key": 18793
  },
  {
   "_id": 18794,
   "ANSWER": "<p><br data-end=\"1660\" data-start=\"1657\" />\nSynchronization is essential to <strong data-end=\"1717\" data-start=\"1692\">avoid race conditions</strong>, <strong data-end=\"1746\" data-start=\"1719\">ensure data consistency</strong>, and <strong data-end=\"1793\" data-start=\"1752\">coordinate access to shared resources</strong> between threads running in parallel.</p>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1",
    "PLO3"
   ],
   "QUESTION_DESC": "<h3 data-end=\"1645\" data-start=\"1573\"><strong data-end=\"1643\" data-start=\"1577\">Why is synchronization important in multithreaded programs?</strong></h3>\n\n<p data-end=\"1830\" data-start=\"1646\">&nbsp;</p>\n\n<p data-end=\"1566\" data-start=\"1367\">&nbsp;</p>\n",
   "SESSION_ID": 209,
   "TYPE": "sq",
