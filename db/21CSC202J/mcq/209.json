 "lq": [
  {
   "_id": 18795,
   "ANSWER": "<p>#include &lt;stdio.h&gt;<br />\n#include &lt;pthread.h&gt;<br />\n#include &lt;unistd.h&gt;</p>\n\n<p>void* print_numbers(void* arg) {<br />\n&nbsp; &nbsp; for (int i = 1; i &lt;= 5; i++) {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; printf(&quot;Number: %d\\n&quot;, i);<br />\n&nbsp; &nbsp; &nbsp; &nbsp; sleep(1);<br />\n&nbsp; &nbsp; }<br />\n&nbsp; &nbsp; return NULL;<br />\n}</p>\n\n<p>void* print_letters(void* arg) {<br />\n&nbsp; &nbsp; for (char ch = &#39;A&#39;; ch &lt;= &#39;E&#39;; ch++) {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; printf(&quot;Letter: %c\\n&quot;, ch);<br />\n&nbsp; &nbsp; &nbsp; &nbsp; sleep(1);<br />\n&nbsp; &nbsp; }<br />\n&nbsp; &nbsp; return NULL;<br />\n}</p>\n\n<p>int main() {<br />\n&nbsp; &nbsp; pthread_t tid1, tid2;</p>\n\n<p>&nbsp; &nbsp; // Create two threads<br />\n&nbsp; &nbsp; pthread_create(&amp;tid1, NULL, print_numbers, NULL);<br />\n&nbsp; &nbsp; pthread_create(&amp;tid2, NULL, print_letters, NULL);</p>\n\n<p>&nbsp; &nbsp; // Wait for threads to finish<br />\n&nbsp; &nbsp; pthread_join(tid1, NULL);<br />\n&nbsp; &nbsp; pthread_join(tid2, NULL);</p>\n\n<p>&nbsp; &nbsp; printf(&quot;Main thread completed.\\n&quot;);<br />\n&nbsp; &nbsp; return 0;<br />\n}<br />\n&nbsp;</p>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 3,
