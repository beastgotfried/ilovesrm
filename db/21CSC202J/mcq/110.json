    "PLO4"
   ],
   "QUESTION_DESC": "<p><span style=\"font-size:13.5pt\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><strong>What is the role of a Shell in the user-OS interface?</strong></span></span></p>\n",
   "SESSION_ID": 110,
   "TYPE": "sq",
   "key": 20944
  },
  {
   "_id": 20945,
   "ANSWER": "<ul>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><strong>System Call:</strong> Direct interface between user applications and the kernel.</span></span></span></li>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><strong>API:</strong> Higher-level function set provided by libraries that internally may use system calls to interact with the OS.</span></span></span></li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2",
    "PLO3",
    "PLO4"
   ],
   "QUESTION_DESC": "<p><span style=\"font-size:13.5pt\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><strong>What is the difference between a system call and an API (Application Programming Interface)?</strong></span></span></p>\n",
   "SESSION_ID": 110,
   "TYPE": "sq",
   "key": 20945
  }
