  {
   "_id": 20773,
   "ANSWER": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">The main components are <strong>Central Processing Unit (CPU)</strong>, <strong>Memory Unit</strong>, <strong>Input/Output Devices</strong>, and <strong>Storage Units</strong>.</span></span></p>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1",
    "PLO2",
    "PLO3"
   ],
   "QUESTION_DESC": "<h3><span style=\"font-size:13.5pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><span style=\"font-weight:bold\"><strong>What are the main components of a computer system?</strong></span></span></span></h3>\n\n<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n",
   "SESSION_ID": 101,
   "TYPE": "sq",
   "key": 20773
  }
