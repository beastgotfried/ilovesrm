 "sq": [
  {
   "_id": 13252,
   "ANSWER": "<p>&nbsp;</p>\n\n<p>&nbsp;</p>\n\n<p data-end=\"2125\" data-start=\"1833\">&nbsp;</p>\n\n<ul data-end=\"1625\" data-start=\"1403\">\n\t<li data-end=\"2937\" data-start=\"2832\">\n\t<p data-end=\"2937\" data-start=\"2834\">User enters a password &rarr; OS hashes it &rarr; compares it with stored hash &rarr; grants access if match is valid; ensures only authenticated users gain system access.</p>\n\t</li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 4,
   "OUTCOMES": [
    "PLO1",
