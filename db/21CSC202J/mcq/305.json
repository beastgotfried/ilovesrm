 "sq": [
  {
   "_id": 12397,
   "ANSWER": "<ul>\n\t<li data-end=\"1929\" data-start=\"1840\">\n\t<p data-end=\"1929\" data-start=\"1842\">Preemptive: a running process can be interrupted if a higher-priority process arrives</p>\n\t</li>\n\t<li data-end=\"2009\" data-start=\"1930\">\n\t<p data-end=\"2009\" data-start=\"1932\">Non-preemptive: the current process finishes before CPU is given to another</p>\n\t</li>\n\t<li data-end=\"2090\" data-start=\"2010\">\n\t<p data-end=\"2090\" data-start=\"2012\">Example scenarios for both</p>\n\t</li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2",
    "PLO3",
    "PLO4",
    "PLO12",
    "PLO13"
   ],
   "QUESTION_DESC": "<p>What is the main difference between Preemptive and Non-Preemptive Priority Scheduling?</p>\n",
   "SESSION_ID": 305,
   "TYPE": "sq",
   "key": 12397
  },
  {
   "_id": 12400,
   "ANSWER": "<ul>\n\t<li data-end=\"1929\" data-start=\"1840\">\n\t<p data-end=\"2250\" data-start=\"2097\"><strong data-end=\"2248\" data-start=\"2233\">Advantages: 50%</strong></p>\n\t</li>\n\t<li data-end=\"2291\" data-start=\"2251\">\n\t<p data-end=\"2291\" data-start=\"2253\">Fairness: all processes get CPU time</p>\n\t</li>\n\t<li data-end=\"2346\" data-start=\"2292\">\n\t<p data-end=\"2346\" data-start=\"2294\">Good for time-sharing systems<br data-end=\"2326\" data-start=\"2323\" />\n\t<strong data-end=\"2344\" data-start=\"2326\">Disadvantages: 50%</strong></p>\n\t</li>\n\t<li data-end=\"2387\" data-start=\"2347\">\n\t<p data-end=\"2387\" data-start=\"2349\">High overhead from context switching</p>\n\t</li>\n\t<li data-end=\"2486\" data-start=\"2388\">\n\t<p data-end=\"2486\" data-start=\"2390\">Poor performance for long burst time processes<br data-end=\"2439\" data-start=\"2436\" />\n\t<b>&nbsp;</b></p>\n\t</li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 1,
   "OUTCOMES": [
