    "PLO13"
   ],
   "QUESTION_DESC": "<p data-end=\"2703\" data-start=\"2575\">Compare and contrast Round Robin Scheduling and Priority Scheduling algorithms in terms of:</p>\n\n<ul data-end=\"2892\" data-start=\"2704\">\n\t<li data-end=\"2731\" data-start=\"2704\">\n\t<p data-end=\"2731\" data-start=\"2706\">Mechanism of scheduling</p>\n\t</li>\n\t<li data-end=\"2759\" data-start=\"2732\">\n\t<p data-end=\"2759\" data-start=\"2734\">Fairness and starvation</p>\n\t</li>\n\t<li data-end=\"2797\" data-start=\"2760\">\n\t<p data-end=\"2797\" data-start=\"2762\">Suitability for different systems</p>\n\t</li>\n\t<li data-end=\"2892\" data-start=\"2798\">\n\t<p data-end=\"2892\" data-start=\"2800\">Handling of waiting and turnaround times<br data-end=\"2843\" data-start=\"2840\" />\n\tProvide suitable examples to justify your answer.</p>\n\t</li>\n</ul>\n",
   "SESSION_ID": 305,
