    "PLO3"
   ],
   "QUESTION_DESC": "<p data-end=\"1770\" data-start=\"1716\">Explain segmentation in memory management. How does it differ from paging?</p>\n\n<p data-end=\"1817\" data-start=\"1772\">&nbsp;</p>\n",
