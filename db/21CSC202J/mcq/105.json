  {
   "_id": 20886,
   "ANSWER": "<h3><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Unlike Monolithic and Microkernels that abstract hardware resources, the <strong>Exokernel exposes hardware resources directly</strong> to applications while enforcing access control, offering minimal abstraction.</span></span></h3>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2",
    "PLO3"
   ],
   "QUESTION_DESC": "<p>Type Here</p>\n\n<h3><span style=\"font-size:13.5pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><span style=\"font-weight:bold\"><strong>How does the Exokernel differ from traditional Monolithic or Microkernel designs?</strong></span></span></span></h3>\n\n<p>&nbsp;</p>\n",
   "SESSION_ID": 105,
   "TYPE": "sq",
   "key": 20886
  },
  {
   "_id": 20888,
   "ANSWER": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">A <strong>Hypervisor</strong> manages Virtual Machines by allocating hardware resources, controlling execution, and isolating VMs from each other, ensuring secure and efficient virtualization.</span></span></p>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 2,
   "OUTCOMES": [
