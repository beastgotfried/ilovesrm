-end=\"1363\" data-start=\"1275\">\n\t<li data-end=\"1306\" data-start=\"1275\">\n\t<p data-end=\"1306\" data-start=\"1277\"><strong data-end=\"1299\" data-start=\"1277\">Total Page Faults:</strong> <strong data-end=\"1306\" data-start=\"1300\">10</strong></p>\n\t</li>\n\t<li data-end=\"1333\" data-start=\"1307\">\n\t<p data-end=\"1333\" data-start=\"1309\"><strong data-end=\"1330\" data-start=\"1309\">Total References:</strong> 12</p>\n\t</li>\n\t<li data-end=\"1363\" data-start=\"1334\">\n\t<p data-end=\"1363\" data-start=\"1336\"><strong data-end=\"1363\" data-start=\"1336\">Page Hits = 12 - 10 = 2 (20%)</strong></p>\n\t</li>\n</ul>\n\n<h3 data-end=\"1418\" data-start=\"1370\">&nbsp;<strong data-end=\"1416\" data-start=\"1377\">Hit Ratio = 2 / 12 = 0.167 or 16.7%&nbsp; (20%)</strong></h3>\n\n<h3 data-end=\"1468\" data-start=\"1419\"><strong data-end=\"1468\" data-start=\"1426\">Fault Ratio = 10 / 12 = 0.833 or 83.3%</strong></h3>\n\n<p>&nbsp;</p>\n\n<ul data-end=\"1270\" data-start=\"1186\">\n</ul>\n",
