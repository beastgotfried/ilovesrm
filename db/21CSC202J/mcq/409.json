  {
   "_id": 12525,
   "ANSWER": "<ol data-end=\"2708\" data-start=\"2499\">\n\t<li data-end=\"2592\" data-start=\"2499\">\n\t<p data-end=\"2592\" data-start=\"2502\"><strong data-end=\"2518\" data-start=\"2502\">Buddy System</strong> &ndash; Allocates memory in <strong data-end=\"2568\" data-start=\"2541\">power-of-2 sized blocks</strong>, easy to split/merge.</p>\n\t</li>\n\t<li data-end=\"2708\" data-start=\"2593\">\n\t<p data-end=\"2708\" data-start=\"2596\"><strong data-end=\"2615\" data-start=\"2596\">Slab Allocation</strong> &ndash; Divides memory into <strong data-end=\"2654\" data-start=\"2638\">caches/slabs</strong> for frequently used kernel objects (efficient reuse).</p>\n\t</li>\n</ol>\n\n<p data-end=\"2735\" data-start=\"2710\"><strong data-end=\"2733\" data-start=\"2713\">Mark Allocation:</strong></p>\n\n<ul data-end=\"2857\" data-start=\"2736\">\n\t<li data-end=\"2775\" data-start=\"2736\">\n\t<p data-end=\"2775\" data-start=\"2738\">Correct names of both methods &ndash; 40%</p>\n\t</li>\n\t<li data-end=\"2811\" data-start=\"2776\">\n\t<p data-end=\"2811\" data-start=\"2778\">Key logic/benefit of each &ndash; 60%</p>\n\t</li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO2"
   ],
   "QUESTION_DESC": "<h3 data-end=\"2065\" data-start=\"1993\">List any two kernel memory allocation methods and describe briefly.</h3>\n",
   "SESSION_ID": 409,
   "TYPE": "sq",
   "key": 12525
  },
  {
   "_id": 12528,
   "ANSWER": "<ol data-end=\"2708\" data-start=\"2499\">\n\t<li data-end=\"1567\" data-start=\"1491\">\n\t<p data-end=\"1567\" data-start=\"1493\"><strong data-end=\"1515\" data-start=\"1493\">Global replacement</strong> allows processes to <strong data-end=\"1552\" data-start=\"1536\">steal frames</strong> from others.</p>\n\t</li>\n\t<li data-end=\"1705\" data-start=\"1568\">\n\t<p data-end=\"1705\" data-start=\"1570\"><strong data-end=\"1591\" data-start=\"1570\">Local replacement</strong> restricts replacement to a process&#39;s <strong data-end=\"1643\" data-start=\"1629\">own frames</strong>.<br data-end=\"1647\" data-start=\"1644\" />\n\tGlobal offers flexibility, while local improves isolation.</p>\n\t</li>\n</ol>\n\n<ul data-end=\"2857\" data-start=\"2736\">\n\t<li data-end=\"2811\" data-start=\"2776\">\n\t<p data-end=\"2811\" data-start=\"2778\">&nbsp;</p>\n\n\t<p data-end=\"1732\" data-start=\"1707\"><strong data-end=\"1730\" data-start=\"1710\">Mark Allocation:</strong></p>\n\t</li>\n\t<li data-end=\"1754\" data-start=\"1733\">\n\t<p data-end=\"1754\" data-start=\"1735\">Definitions &ndash; 40%</p>\n\t</li>\n\t<li data-end=\"1790\" data-start=\"1755\">\n\t<p data-end=\"1790\" data-start=\"1757\">Difference clearly stated &ndash; 40%</p>\n\t</li>\n\t<li data-end=\"1853\" data-start=\"1791\">\n\t<p data-end=\"1853\" data-start=\"1793\">Correct terms (stealing/isolation) &ndash; 20%</p>\n\t</li>\n</ul>\n",
   "COURSE_CODE": "21CSC202J",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO2"
   ],
