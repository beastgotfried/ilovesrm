   "OUTCOMES": [
    "PLO1",
    "PLO2",
    "PLO3"
   ],
   "QUESTION_DESC": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><strong>What is a Process Control Block (PCB) and why is it important?</strong></span></span></p>\n",
   "SESSION_ID": 106,
