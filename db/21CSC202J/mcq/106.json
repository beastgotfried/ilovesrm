  },
  {
   "_id": 20902,
   "ANSWER": "<p>&nbsp;</p>\n\n<ul>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><strong>Logical Address:</strong> Generated by the CPU; also called virtual address.</span></span></span></li>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\"><strong>Physical Address:</strong> Actual location in main memory.<br />\n\tThe Memory Management Unit (MMU) translates logical addresses to physical addresses.</span></span></span></li>\n</ul>\n",
