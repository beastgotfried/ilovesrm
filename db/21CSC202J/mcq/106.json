  {
   "_id": 20901,
   "ANSWER": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">A PCB is a data structure maintained by the operating system that contains information about a specific process, such as its process state, program counter, CPU registers, scheduling information, memory management details, and I/O status. It is essential for process switching and management.</span></span></p>\n",
   "COURSE_CODE": "21CSC202J",
