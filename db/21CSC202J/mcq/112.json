   "ANSWER": "<ul>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\">ssh</span></code> &mdash; Secure Shell for remote login</span></span></span></li>\n\t<li style=\"margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list .5in\"><span style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\">ftp</span></code> &mdash; File Transfer Protocol for data exchange</span></span></span></li>\n</ul>\n",
