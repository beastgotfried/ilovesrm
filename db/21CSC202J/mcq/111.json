  {
   "_id": 21099,
   "ANSWER": "<p style=\"margin-left:8px\"><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">They handle file creation, deletion, reading, writing, and permission changes.<br />\n<strong><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">Examples:</span></strong> </span></span></span><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\"><span style=\"line-height:107%\">open()</span></span></code><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">, </span></span></span><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\"><span style=\"line-height:107%\">read()</span></span></code><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">, </span></span></span><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\"><span style=\"line-height:107%\">write()</span></span></code><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">, </span></span></span><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\"><span style=\"line-height:107%\">close()</span></span></code><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">, </span></span></span><code style=\"font-family:&quot;Courier New&quot;\"><span style=\"font-size:10.0pt\"><span style=\"line-height:107%\">chmod()</span></span></code></p>\n",
