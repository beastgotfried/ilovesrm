   "COURSE_CODE": "21CSC202J",
   "LEVEL": 2,
   "OPT_1": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Simple OS lacks kernel-level multitasking; Monolithic supports multitasking within kernel</span></span></p>\n",
   "OPT_2": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Simple OS supports distributed systems; Monolithic does not</span></span></p>\n",
   "OPT_3": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Monolithic OS operates in user mode only</span></span></p>\n",
   "OPT_4": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Simple OS strictly enforces modularity</span></span></p>\n",
   "OUTCOMES": [
