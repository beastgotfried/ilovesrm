   "OPT_1": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Runs most OS services in user mode</span></span></p>\n",
   "OPT_2": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Provides minimal functionality and relies on user-space servers</span></span></p>\n",
