   "OPT_1": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">They eliminate the need for device drivers</span></span></p>\n",
   "OPT_2": "<p><span style=\"font-size:12pt\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">They provide a balance between modularity, performance, and practical system design</span></span></p>\n",
