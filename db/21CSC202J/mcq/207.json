   "QUESTION_DESC": "<h3 data-end=\"585\" data-start=\"515\"><strong data-end=\"583\" data-start=\"519\">In the many-to-one model, all user threads are mapped to:</strong></h3>\n\n<p data-end=\"686\" data-start=\"586\">&nbsp;</p>\n\n<p data-end=\"480\" data-start=\"413\">&nbsp;</p>\n",
