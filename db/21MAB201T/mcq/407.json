  {
   "_id": 52811,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{We know } F_s[e^{-ax}] = \\sqrt{\\frac{2}{\\pi}} \\frac{s}{s^2+a^2}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{By inverse sine transform: } e^{-ax} = \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} F_s(s) \\sin(sx) ds\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(= \\frac{2}{\\pi} \\int_{0}^{\\infty} \\frac{s}{s^2+a^2} \\sin(sx) ds\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Interchange x and s: } \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} \\frac{x}{x^2+a^2} \\sin(sx) dx = \\sqrt{\\frac{\\pi}{2}} e^{-as}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Hence } F_s\\left[\\frac{x}{x^2+a^2}\\right] = \\sqrt{\\frac{\\pi}{2}} e^{-as}.\\)</span></p></td><td></td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{Find the Fourier sine transform of } f(x) = \\frac{x}{x^2+a^2}.\\)</span></p>",
   "SESSION_ID": 407,
   "TYPE": "sq",
   "key": 52811
  },
  {
   "_id": 52812,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{We know } F_c[e^{-ax}] = \\sqrt{\\frac{2}{\\pi}} \\frac{a}{a^2+s^2}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{By inverse cosine transform: } e^{-ax} = \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} F_c(s) \\cos(sx) ds\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(= \\frac{2a}{\\pi} \\int_{0}^{\\infty} \\frac{1}{a^2+s^2} \\cos(sx) ds\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Interchange x and s: } \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} \\frac{1}{x^2+a^2} \\cos(sx) dx = \\sqrt{\\frac{\\pi}{2}} \\frac{e^{-as}}{a}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Hence } F_c\\left[\\frac{1}{x^2+a^2}\\right] = \\sqrt{\\frac{\\pi}{2}} \\frac{e^{-as}}{a}.\\)</span></p></td><td></td></tr></table>",
   "COURSE_CODE": "21MAB201T",
