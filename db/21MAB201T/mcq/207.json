 "sq": [
  {
   "_id": 50037,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Extend } f(x) \\text{ as odd function to } (-L, L)\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Half-range sine series: } f(x) = \\sum_{n=1}^{\\infty} b_n \\sin(\\frac{n\\pi x}{L})\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{where: } b_n = \\frac{2}{L} \\int_0^{L} f(x) \\sin(\\frac{n\\pi x}{L}) dx\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Constant term } a_0 = 0 \\text{ and } a_n = 0\\)</span></p></td><td>(2 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{Define half-range sine series for } f(x) \\text{ in } (0, L).\\)</span></p>",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 50037
  },
  {
   "_id": 50038,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(b_n = \\frac{2}{L} \\int_0^{L} x \\sin(\\frac{n\\pi x}{L}) dx\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Integration: } = \\frac{2L}{n\\pi}(-1)^{n+1}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Thus } x = \\frac{2L}{\\pi}\\sum_{n=1}^{\\infty} \\frac{(-1)^{n+1}}{n} \\sin(\\frac{n\\pi x}{L})\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Or equivalently: } x = \\frac{2L}{\\pi}\\sum_{n=1}^{\\infty} \\frac{1}{n} \\sin(\\frac{n\\pi x}{L}) \\text{ with phase adjustment}\\)</span></p></td><td>(2 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 4,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{Find half-range sine series for } f(x) = x \\text{ in } (0, L).\\)</span></p>",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 50038
  },
  {
   "_id": 50039,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Define } f_o(x) = \\begin{cases} f(x) & 0 \\leq x \\leq L \\\\ -f(-x) & -L \\leq x \\leq 0 \\end{cases}\\)</span></p></td><td>(4 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{This makes } f_o(x) \\text{ odd function in } (-L, L)\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Fourier series of } f_o(x) \\text{ is sine series representing } f(x) \\text{ in } (0, L)\\)</span></p></td><td>(2 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{What is odd extension of function for half-range sine series?}\\)</span></p>",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 50039
  },
  {
   "_id": 50040,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(b_n = \\frac{2}{\\pi} \\int_0^{\\pi} (\\pi - x) \\sin nx dx\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Split: } = 2\\int_0^{\\pi} \\sin nx dx - \\frac{2}{\\pi}\\int_0^{\\pi} x \\sin nx dx\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Evaluate: } = \\frac{2}{n}[1 - (-1)^n] - \\frac{2}{n}(-1)^{n+1} = \\frac{2}{n}\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Thus } \\pi - x = 2\\sum_{n=1}^{\\infty} \\frac{1}{n} \\sin nx\\)</span></p></td><td>(2 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 4,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{Find half-range sine series for } f(x) = \\pi - x \\text{ in } (0, \\pi).\\)</span></p>",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 50040
  },
  {
   "_id": 50041,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Cosine series converges to } f(0+) \\text{ at } x=0 \\text{ and } f(L-) \\text{ at } x=L\\)</span></p></td><td>(3 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Sine series converges to 0 at } x=0 \\text{ and } x=L \\text{ (odd extension forces zero)}\\)</span></p></td><td>(3 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Choose appropriate series based on boundary conditions}\\)</span></p></td><td>(2 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{Compare half-range cosine and sine series convergence at endpoints.}\\)</span></p>",
   "SESSION_ID": 207,
