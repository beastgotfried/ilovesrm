  {
   "_id": 32103,
   "ANSWER": "<p><span id=\"cke_bm_13500S\" style=\"display: none;\">&nbsp;</span>1.write boundary conditions (BC) and initial conditions (IC)</p>\n\n<p>2. Apply the BC&nbsp;and IC</p>\n\n<p>3. will get&nbsp;<span class=\"math-tex\">\\(A=0 , p=\\frac{n\\pi }{l} , C=0\\)</span></p>\n\n<p>4.&nbsp;<span class=\"math-tex\">\\(y(x,t)=\\sum_{n=0}^{\\infty } \\lambda _{n} sin\\left ( \\frac{n\\pi x}{l} \\right )sin \\left ( \\frac{n\\pi at}{l}\\right )\\)</span></p>\n",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p style=\"text-align:justify; margin-bottom:13px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Find general solution for the displacement y(x,t) of the string of length <i>l</i> vibrating between fixed end points </span></span></span><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 12pt;\">with initial&nbsp;displacement zero and initial&nbsp;velocity <em>f(x).</em></span></p>\n",
   "SESSION_ID": 303,
   "TYPE": "sq",
   "key": 32103
  },
  {
   "_id": 32108,
   "ANSWER": "<p>1.write boundary conditions (BC) and initial conditions (IC)</p>\n\n<p>2. Apply the BC&nbsp;and IC</p>\n\n<p>3. will get&nbsp;<span class=\"math-tex\">\\(A=0 , p=\\frac{n\\pi }{10} , C=0\\)</span></p>\n\n<p>4.&nbsp;<span class=\"math-tex\">\\(y(x,t)=\\sum_{n=0}^{\\infty } \\lambda _{n} sin\\left ( \\frac{n\\pi x}{10} \\right )sin \\left ( \\frac{n\\pi at}{10}\\right )\\)</span></p>\n",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p style=\"text-align:justify; margin-bottom:13px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Find general solution for the displacement y(x,t) of the string of length <i>10cm</i>&nbsp;vibrating between fixed end points </span></span></span><span style=\"font-family: &quot;Times New Roman&quot;, serif; font-size: 12pt;\">with initial&nbsp;displacement zero and initial&nbsp;velocity <em>k.</em></span></p>\n",
   "SESSION_ID": 303,
   "TYPE": "sq",
   "key": 32108
  },
  {
   "_id": 52782,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Solve wave equation with conditions: } y(0,t)=0, y(l,t)=0, y(x,0)=0, y_t(x,0)=v_0 \\sin(3\\pi x/l).\\)</span></p></td><td>(1 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{General solution: } y(x,t)=\\sum_{n=1}^\\infty B_n \\sin\\frac{n\\pi x}{l} \\sin\\frac{n\\pi c t}{l}.\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Using initial velocity: } v_0 \\sin\\frac{3\\pi x}{l} = \\sum_{n=1}^\\infty B_n \\frac{n\\pi c}{l} \\sin\\frac{n\\pi x}{l}.\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Equate coefficients: } B_3 \\frac{3\\pi c}{l} = v_0 \\Rightarrow B_3 = \\frac{l v_0}{3\\pi c}, \\text{ other } B_n=0.\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Hence } y(x,t) = \\frac{l v_0}{3\\pi c} \\sin\\frac{3\\pi x}{l} \\sin\\frac{3\\pi c t}{l}.\\)</span></p></td><td>(1 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{A string of length } l \\text{ fixed at both ends is initially at rest in equilibrium. Given initial velocity } \\frac{\\partial y}{\\partial t}(x,0) = v_0 \\sin\\frac{3\\pi x}{l}, \\text{ find the displacement } y(x,t).\\)</span></p>",
   "SESSION_ID": 303,
   "TYPE": "sq",
   "key": 52782
  },
  {
   "_id": 52783,
   "ANSWER": "<table><tr><th>Upto the step</th><th>Marks</th></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Conditions: } y(0,t)=0, y(l,t)=0, y(x,0)=0, y_t(x,0)=kx(l-x).\\)</span></p></td><td>(1 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{General solution: } y(x,t)=\\sum_{n=1}^\\infty B_n \\sin\\frac{n\\pi x}{l} \\sin\\frac{n\\pi c t}{l}.\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Using initial velocity: } kx(l-x) = \\sum_{n=1}^\\infty B_n \\frac{n\\pi c}{l} \\sin\\frac{n\\pi x}{l}.\\)</span></p></td><td>(1 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Express RHS as Fourier sine series: } B_n \\frac{n\\pi c}{l} = \\frac{2}{l} \\int_0^l kx(l-x) \\sin\\frac{n\\pi x}{l} dx.\\)</span></p></td><td>(2 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Evaluate integral: } = \\frac{4kl^2}{n^3\\pi^3}[1-(-1)^n]. \\text{ For odd } n, B_n = \\frac{8kl^3}{n^4\\pi^4 c}.\\)</span></p></td><td>(1 Mark)</td></tr><tr><td><p><span class=\"math-tex\">\\(\\text{Thus } y(x,t) = \\frac{8kl^3}{\\pi^4 c} \\sum_{n=\\text{odd}} \\frac{1}{n^4} \\sin\\frac{n\\pi x}{l} \\sin\\frac{n\\pi c t}{l}.\\)</span></p></td><td>(1 Mark)</td></tr></table>",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 4,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{A string of length } l \\text{ fixed at ends is initially at rest. Given initial velocity } \\frac{\\partial y}{\\partial t}(x,0) = kx(l-x), \\text{ find } y(x,t).\\)</span></p>",
   "SESSION_ID": 303,
   "TYPE": "sq",
   "key": 52783
  }
