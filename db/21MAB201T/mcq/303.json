 "lq": [
  {
   "_id": 50392,
   "ANSWER": "<table>\n\t<tbody>\n\t\t<tr>\n\t\t\t<th>Step</th>\n\t\t\t<th>Marks</th>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Wave equation: \\(y_{tt} = c^2 y_{xx}\\). Boundary conditions: \\(y(0,t)=0\\), \\(y(l,t)=0\\).}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Initial conditions: \\(y(x,0)=0\\), \\(y_t(x,0)=v_0 \\sin\\left(\\dfrac{3\\pi x}{l}\\right).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{General solution from separation: \\(y(x,t)=\\sum \\sin\\left(\\dfrac{n\\pi x}{l}\\right)\\left[C_n \\cos\\left(\\dfrac{n\\pi c t}{l}\\right)+D_n \\sin\\left(\\dfrac{n\\pi c t}{l}\\right)\\right].\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Apply \\(y(x,0)=0\\) \\(\\Rightarrow\\) \\(\\sum C_n \\sin\\left(\\dfrac{n\\pi x}{l}\\right) = 0\\) \\(\\Rightarrow\\) \\(C_n = 0\\) for all \\(n\\).}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Then \\(y(x,t)= \\sum D_n \\sin\\left(\\dfrac{n\\pi x}{l}\\right) \\sin\\left(\\dfrac{n\\pi c t}{l}\\right).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Differentiate: \\(y_t(x,t)= \\sum D_n \\left(\\dfrac{n\\pi c}{l}\\right) \\sin\\left(\\dfrac{n\\pi x}{l}\\right) \\cos\\left(\\dfrac{n\\pi c t}{l}\\right).\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{At \\(t=0\\): \\(y_t(x,0)= \\sum D_n \\left(\\dfrac{n\\pi c}{l}\\right) \\sin\\left(\\dfrac{n\\pi x}{l}\\right) = v_0 \\sin\\left(\\dfrac{3\\pi x}{l}\\right).\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Equate coefficients: \\(D_3 \\left(\\dfrac{3\\pi c}{l}\\right) = v_0\\) \\(\\Rightarrow\\) \\(D_3 = \\dfrac{v_0 l}{3\\pi c}\\). All other \\(D_n=0\\).}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Thus \\(y(x,t) = \\dfrac{v_0 l}{3\\pi c} \\sin\\left(\\dfrac{3\\pi x}{l}\\right) \\sin\\left(\\dfrac{3\\pi c t}{l}\\right).\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t</tbody>\n</table>\n",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{A string of length  $l$  is fixed at both ends. It is given an initial displacement  \\(y(x,0) = 0\\)}\\\\\n\\text{and an initial velocity $ \\frac{\\partial y}{\\partial t}(x,0) = v_0 \\sin\\left(\\dfrac{3\\pi x}{l}\\right).$}\\\\\\text{Find the displacement  $y(x,t)$ at any time  $t&gt;0.$}\\)</span></p>\n",
   "SESSION_ID": 303,
   "TYPE": "lq",
   "key": 50392
  },
  {
   "_id": 50393,
   "ANSWER": "<table>\n\t<tbody>\n\t\t<tr>\n\t\t\t<th>Step</th>\n\t\t\t<th>Marks</th>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Wave equation: \\(y_{tt} = c^2 y_{xx}\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Initial conditions: \\(y(x,0)=0\\), \\(y_t(x,0)=x(\\pi-x).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{General solution: \\(y(x,t)= \\sum\\limits_{n=1}^{\\infty} \\sin(nx)\\left[C_n \\cos(nct)+D_n \\sin(nct)\\right].\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Apply \\(y(x,0)=0\\) \\(\\Rightarrow\\) \\(C_n=0\\) for all \\(n\\).}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Thus \\(y(x,t)= \\sum D_n \\sin(nx) \\sin(nct).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Then \\(y_t(x,t)= \\sum D_n nc \\sin(nx) \\cos(nct).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{At \\(t=0\\): \\(y_t(x,0)= \\sum D_n nc \\sin(nx) = x(\\pi-x).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Expand \\(x(\\pi-x)\\) in Fourier sine series on \\((0,\\pi)\\): \\(x(\\pi-x)= \\sum b_n \\sin(nx),\\) where \\(b_n = \\dfrac{2}{\\pi}\\int_0^{\\pi} x(\\pi-x) \\sin(nx) dx.\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Compute \\(b_n\\): integration by parts gives \\(b_n = \\dfrac{4}{\\pi n^3}[1-(-1)^n].\\) So \\(b_n = \\dfrac{8}{\\pi n^3}\\) for \\(n\\) odd, \\(0\\) for \\(n\\) even.}\\)</span></td>\n\t\t\t<td>(3 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Thus \\(D_n nc = b_n\\) \\(\\Rightarrow\\) \\(D_n = \\dfrac{b_n}{nc}.\\) For \\(n\\) odd: \\(D_n = \\dfrac{8}{\\pi n^4 c}.\\)}\\)</span></td>\n\t\t\t<td>(2 Marks)</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><span class=\"math-tex\">\\(\\text{Final: \\(y(x,t)= \\sum\\limits_{n \\text{ odd}} \\dfrac{8}{\\pi n^4 c} \\sin(nx) \\sin(nct).\\)}\\)</span></td>\n\t\t\t<td>(1 Mark)</td>\n\t\t</tr>\n\t</tbody>\n</table>\n",
   "COURSE_CODE": "21MAB201T",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p><span class=\"math-tex\">\\(\\text{A string of length } \\pi \\text{ is fixed at both ends. It is given an initial displacement  y(x,0)=0}\\\\\n\\text{and an initial velocity  \\(\\frac{\\partial y}{\\partial t}(x,0) = x(\\pi - x).\\)}\\\\\n\\text{Find the displacement \\( y(x,t).\\)}\\)</span></p>\n",
   "SESSION_ID": 303,
   "TYPE": "lq",
   "key": 50393
  }
 ]
