   ],
   "QUESTION_DESC": "<p style=\"text-align:justify; margin-bottom:11px\"><b><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">Discuss the merits of using a linked list over an array for queue implementation?</span></span></span></b></p>\n",
   "SESSION_ID": 310,
   "TYPE": "sq",
   "key": 5177
  }
 ],
 "lq": [
  {
   "_id": 5197,
   "ANSWER": "<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>1. Recommended Implementation: Linked List</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;Using a <b>linked list</b> to implement the food delivery order queue.</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>2. Justification:</b></span></span></span></p>\n\n<table class=\"Table\" style=\"border:solid windowtext 1px\">\n\t<thead>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>Aspect</b></span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>Linked List Implementation</b></span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Memory Management</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Dynamically allocates memory. No wastage, as memory is used only when needed.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Scalability</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Supports unlimited orders (as long as memory is available), ideal for variable load.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Overflow Handling</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">No overflow unless the system memory is completely exhausted.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Underflow Handling</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Easily detected if front == NULL.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Efficiency</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Enqueue and dequeue operations are O(1) without shifting.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Real-Time Use Case</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"border-bottom:1px solid black; padding:.100px .100px .100px .100px; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">New orders and processing can happen smoothly without delay.</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>3. Code Snippets in C</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Node Structure:</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">struct Order {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int orderID;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; char customerName[50];</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; struct Order* next;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">};</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">struct Order* front = NULL;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">struct Order* rear = NULL;</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">Enqueue Function:</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">void enqueue(int id, char name[]) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; struct Order* newOrder = (struct Order*)malloc(sizeof(struct Order));</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; newOrder-&gt;orderID = id;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; strcpy(newOrder-&gt;customerName, name);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; newOrder-&gt;next = NULL;</span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if (rear == NULL) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; front = rear = newOrder;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; } else {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; rear-&gt;next = newOrder;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; rear = newOrder;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;Order ID %d added for %s\\n&quot;, id, name);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">}</span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">Dequeue Function:</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">void dequeue() {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if (front == NULL) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;No orders to process.\\n&quot;);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; return;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; struct Order* temp = front;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;Processing Order ID %d for %s\\n&quot;, temp-&gt;orderID, temp-&gt;customerName);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; front = front-&gt;next;</span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if (front == NULL) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; rear = NULL;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; free(temp);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">}</span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">Display Function:</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">void displayQueue() {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if (front == NULL) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;No pending orders.\\n&quot;);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; return;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; struct Order* temp = front;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;Current order queue:\\n&quot;);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; while (temp != NULL) {</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;Order ID: %d | Customer: %s\\n&quot;, temp-&gt;orderID, temp-&gt;customerName);</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; temp = temp-&gt;next;</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\">}</span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><b>4. Handling Overflow and Underflow:</b></span></span></span></p>\n\n<ul>\n\t<li><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"tab-stops:list 36.0pt\"><span style=\"font-family:Aptos,sans-serif\"><b>Overflow:</b> Not a major concern here, because linked lists dynamically allocate memory. The only limit is the system&rsquo;s available memory.</span></span></span></span></li>\n\t<li><span style=\"font-size:11pt\"><span style=\"line-height:normal\"><span style=\"tab-stops:list 36.0pt\"><span style=\"font-family:Aptos,sans-serif\"><b>Underflow:</b> Occurs when there are no orders in the queue (front == NULL). This is handled with a proper check at the start of the dequeue function.</span></span></span></span></li>\n</ul>\n\n<p>&nbsp;</p>\n",
