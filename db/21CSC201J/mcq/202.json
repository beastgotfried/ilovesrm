  {
   "_id": 5081,
   "ANSWER": "<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">#include &lt;stdio.h&gt;</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">int main() {</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int rollNumbers[10] = {101, 102, 103, 104, 105, 106, 107, 108, 109, 110};</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int i, searchRoll, found = 0;</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; // Traversal: Display all roll numbers</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;List of Roll Numbers in the Class:\\n&quot;);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; for(i = 0; i &lt; 10; i++) {</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;%d &quot;, rollNumbers[i]);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; // Searching: Ask user for a roll number to search</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;\\n\\nEnter the roll number to search: &quot;);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; scanf(&quot;%d&quot;, &amp;searchRoll);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; for(i = 0; i &lt; 10; i++) {</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; if(rollNumbers[i] == searchRoll) {</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;Roll number %d found at position %d.\\n&quot;, searchRoll, i + 1);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; found = 1;</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; break;</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if(!found) {</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;Roll number %d not found in the class.\\n&quot;, searchRoll);</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></p>\n\n<p style=\"margin-left:48px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; return 0;</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">}</span></span></span></p>\n",
