   ],
   "QUESTION_DESC": "<p><span style=\"font-size:12.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">A librarian maintains a list of book IDs in an array. If a book is removed from the library, its ID must also be removed from the array. Explain the algorithm used to delete a book ID from the array</span></span></span></p>\n",
   "SESSION_ID": 202,
