  {
   "_id": 5080,
   "ANSWER": "<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">To delete an element (book ID) from an array, we need to <b>find the position</b> of the element first, and then <b>shift the remaining elements</b> to maintain the array structure.</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><b>Algorithm to Delete an Element from an Array:</b></span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><b>Step 1:</b> Start<br />\n<b>Step 2:</b> Input the array arr[] and the total number of elements n<br />\n<b>Step 3:</b> Input the position pos of the element to be deleted (or search for the value first if needed)<br />\n<b>Step 4:</b> Starting from index pos - 1, shift each element one position to the left<br />\n<b>Step 5:</b> Decrease n by 1 (since one element is deleted)<br />\n<b>Step 6:</b> Output the updated array<br />\n<b>Step 7:</b> Stop</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">#include &lt;stdio.h&gt;</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">int main() {</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int arr[100] = {101, 102, 103, 104, 105};</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int n = 5;</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; int pos, i;</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; // Input: position to delete</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; printf(&quot;Enter position to delete (1 to %d): &quot;, n);</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; scanf(&quot;%d&quot;, &amp;pos);</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; // Deletion logic</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; if(pos &lt; 1 || pos &gt; n) {</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;Invalid position!\\n&quot;);</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; } else {</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; for(i = pos - 1; i &lt; n - 1; i++) {</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; arr[i] = arr[i + 1];</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; n--;</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; // Output updated array</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;Updated Book IDs:\\n&quot;);</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; for(i = 0; i &lt; n; i++) {</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; printf(&quot;%d &quot;, arr[i]);</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">&nbsp;&nbsp;&nbsp; return 0;</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">}</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">OUTPUT:</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">Enter position to delete (1 to 5): 3</span></span></span></span></p>\n\n<p style=\"margin-left:9px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">Updated Book IDs:</span></span></span></span></p>\n\n<p style=\"margin-left:9px; margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:7.1pt 21.3pt 35.45pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">101 102 104 105</span></span></span></span></p>\n",
   "COURSE_CODE": "21CSC201J",
