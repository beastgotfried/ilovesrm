   "QUESTION_DESC": "<p style=\"margin-bottom:11px\"><b><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">What is the primary advantage of implementing a BST using a linked list instead of an array?</span></span></span></b></p>\n",
   "SESSION_ID": 409,
