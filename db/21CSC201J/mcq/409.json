   "COURSE_CODE": "21CSC201J",
   "LEVEL": 1,
   "OPT_1": "<p><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">It requires traversal of the entire tree</span></span></span></p>\n",
   "OPT_2": "<p><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">The BST becomes unbalanced</span></span></span></p>\n",
   "OPT_3": "<p><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">The node is replaced with its in-order successor</span></span></span><br />\n<br />\n&nbsp;</p>\n",
   "OPT_4": "<p><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\">The node is simply removed</span></span></span></p>\n",
