   "QUESTION_DESC": "<p style=\"margin-bottom:11px\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Aptos,sans-serif\"><b>Explain any two real-world applications of stacks with examples.</b></span></span></span></p>\n",
