   "QUESTION_DESC": "<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Consider you are developing a student management system for a college. The system stores the roll numbers of students in an array in the order of their registration.</span></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">The admin wants to insert a new student&rsquo;s roll number at a specific position (not necessarily the end), depending on priority registration.</span></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Write a C++ program that:</span></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Takes an array of roll numbers</span></span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Inserts a new roll number at a given position</span></span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><span style=\"font-family:&quot;Times New Roman&quot;,serif\">Displays the updated list of roll numbers</span></span></span></span></span></li>\n</ul>\n",
