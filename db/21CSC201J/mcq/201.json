   "ANSWER": "<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">#include &lt;iostream.h&gt;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">void insertRollNumber(int roll[], int&amp; size, int capacity, int newRoll, int position) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; if (size &gt;= capacity) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; cout &lt;&lt; &quot;Error: Roll list is full.\\n&quot;;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; return;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; if (position &lt; 0 || position &gt; size) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; cout &lt;&lt; &quot;Error: Invalid position.\\n&quot;;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; return;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p>&nbsp;</p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; // Shift elements to the right</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; for (int i = size - 1; i &gt;= position; i--) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; roll[i + 1] = roll[i];</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; // Insert new roll number</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; roll[position] = newRoll;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; size++;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">}</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">void printRollNumbers(int roll[], int size) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; for (int i = 0; i &lt; size; i++) {</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; cout &lt;&lt; roll[i] &lt;&lt; &quot; &quot;;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; }</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">&nbsp;&nbsp;&nbsp; cout &lt;&lt; endl;</span></span></span></span></p>\n\n<p><span style=\"font-size:12pt\"><span style=\"line-height:normal\"><span style=\"font-family:Aptos,sans-serif\"><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,serif\">}</span></span></span></span></p>\n",
