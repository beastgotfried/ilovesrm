   "OPT_3": "<p style=\"margin-bottom:11px; margin-left:8px\"><i><span style=\"font-size:12.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif\">\u019f</span></span></span></i><span style=\"font-size:12.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">&nbsp;(<i>n</i><sup>3</sup></span></span></span></p>\n",
