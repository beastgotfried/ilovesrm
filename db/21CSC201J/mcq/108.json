   "OPT_4": "<p style=\"margin-bottom:11px; margin-left:8px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:21.3pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\">There are &lsquo;n&rsquo; number of statements in the algorithm</span></span></span></span></p>\n",
