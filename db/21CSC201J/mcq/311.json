   "QUESTION_DESC": "<p style=\"text-align:justify; margin-bottom:11px\"><b><span style=\"font-size:11.0pt\"><span style=\"line-height:107%\"><span style=\"font-family:&quot;Aptos&quot;,sans-serif\">What is a circular queue? How does it differ from a linear queue?</span></span></span></b></p>\n",
