 "sq": [
  {
   "_id": 9862,
   "ANSWER": "<p data-end=\"6516\" data-start=\"6456\"><br data-end=\"6800\" data-start=\"6797\" />\nUDP is lightweight and doesn&rsquo;t require a handshake, making it faster.<br data-end=\"6872\" data-start=\"6869\" />\nIt&rsquo;s ideal for periodic, non-critical data where occasional loss is tolerable.<br data-end=\"6953\" data-start=\"6950\" />\nLess overhead also reduces energy consumption in IoT devices.</p>\n",
   "COURSE_CODE": "21CSC203P",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO2",
    "PLO1",
    "PLO4"
   ],
   "QUESTION_DESC": "<p data-end=\"6516\" data-start=\"6456\">A sensor sends temperature every second. Why use UDP?<br data-end=\"6791\" data-start=\"6788\" />\n&nbsp;</p>\n\n<p data-end=\"4958\" data-start=\"4681\">&nbsp;</p>\n",
   "SESSION_ID": 411,
   "TYPE": "sq",
   "key": 9862
  },
  {
   "_id": 9863,
   "ANSWER": "<p><code>import socket s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM) s.sendto(b&#39;data&#39;, (&#39;localhost&#39;, 12345)) </code></p>\n\n<p data-end=\"7266\" data-start=\"7215\">This sends a UDP datagram to the given IP and port.</p>\n",
   "COURSE_CODE": "21CSC203P",
   "LEVEL": 2,
