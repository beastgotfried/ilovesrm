 "sq": [
  {
   "_id": 9357,
   "ANSWER": "<p>By distributing tasks across multiple cores or processors, parallel computing enables simultaneous data processing, thereby reducing execution time and increasing efficiency.</p>\n",
   "COURSE_CODE": "21CSC203P",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p>A data processing system handles large datasets and experiences delays. How can parallel computing improve performance?</p>\n",
   "SESSION_ID": 105,
   "TYPE": "sq",
   "key": 9357
  },
  {
   "_id": 9358,
   "ANSWER": "<p>Tasks such as image transformations and shading can be processed concurrently, maximizing hardware utilization and delivering faster rendering speeds.</p>\n",
   "COURSE_CODE": "21CSC203P",
   "LEVEL": 2,
   "OUTCOMES": [
    "PLO1",
    "PLO2"
   ],
   "QUESTION_DESC": "<p>A graphics rendering engine must perform multiple calculations at once. What advantage does parallelism offer in this scenario?</p>\n",
   "SESSION_ID": 105,
   "TYPE": "sq",
   "key": 9358
  }
 ],
