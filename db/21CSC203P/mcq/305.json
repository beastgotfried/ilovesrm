 "lq": [
  {
   "_id": 10414,
   "ANSWER": "<p>import java.sql.*;</p>\n\n<p>public class UniversityApp {<br />\n&nbsp; &nbsp; public static void main(String[] args) {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; String url = &quot;jdbc:mysql://localhost:3306/university&quot;;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; String user = &quot;root&quot;;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; String password = &quot;admin&quot;;<br />\n&nbsp; &nbsp; &nbsp; &nbsp; String sql = &quot;SELECT name, marks FROM students WHERE department = ? AND marks &gt; ?&quot;;</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; try {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Load driver<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Create connection<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Connection con = DriverManager.getConnection(url, user, password);</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Prepare statement (imperative)<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; PreparedStatement pstmt = con.prepareStatement(sql);<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; pstmt.setString(1, &quot;CSE&quot;);<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; pstmt.setInt(2, 75);</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Execute query<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ResultSet rs = pstmt.executeQuery();</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Process result<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; while (rs.next()) {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; System.out.println(rs.getString(&quot;name&quot;) + &quot; - &quot; + rs.getInt(&quot;marks&quot;));<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</p>\n\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // Close resources<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; rs.close();<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; pstmt.close();<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; con.close();<br />\n&nbsp; &nbsp; &nbsp; &nbsp; } catch (Exception e) {<br />\n&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; e.printStackTrace();<br />\n&nbsp; &nbsp; &nbsp; &nbsp; }<br />\n&nbsp; &nbsp; }<br />\n}</p>\n\n<p data-end=\"5831\" data-start=\"5815\"><strong data-end=\"5831\" data-start=\"5815\">Explanation:</strong></p>\n\n<table data-end=\"6234\" data-start=\"5833\">\n\t<thead data-end=\"5867\" data-start=\"5833\">\n\t\t<tr data-end=\"5867\" data-start=\"5833\">\n\t\t\t<th data-col-size=\"md\" data-end=\"5845\" data-start=\"5833\">Component</th>\n\t\t\t<th data-col-size=\"sm\" data-end=\"5852\" data-start=\"5845\">Type</th>\n\t\t\t<th data-col-size=\"md\" data-end=\"5867\" data-start=\"5852\">Description</th>\n\t\t</tr>\n\t</thead>\n\t<tbody data-end=\"6234\" data-start=\"5902\">\n\t\t<tr data-end=\"5977\" data-start=\"5902\">\n\t\t\t<td data-col-size=\"md\" data-end=\"5929\" data-start=\"5902\">SQL Query (<code data-end=\"5927\" data-start=\"5915\">SELECT ...</code>)</td>\n\t\t\t<td data-col-size=\"sm\" data-end=\"5943\" data-start=\"5929\">Declarative</td>\n\t\t\t<td data-col-size=\"md\" data-end=\"5977\" data-start=\"5943\">Specifies <em data-end=\"5961\" data-start=\"5955\">what</em> data to fetch</td>\n\t\t</tr>\n\t\t<tr data-end=\"6074\" data-start=\"5978\">\n\t\t\t<td data-col-size=\"md\" data-end=\"5995\" data-start=\"5978\">Java JDBC Code</td>\n\t\t\t<td data-col-size=\"sm\" data-end=\"6008\" data-start=\"5995\">Imperative</td>\n\t\t\t<td data-col-size=\"md\" data-end=\"6074\" data-start=\"6008\">Specifies <em data-end=\"6025\" data-start=\"6020\">how</em> to connect, prepare, execute, and process data</td>\n\t\t</tr>\n\t\t<tr data-end=\"6234\" data-start=\"6075\">\n\t\t\t<td data-col-size=\"md\" data-end=\"6141\" data-start=\"6075\"><code data-end=\"6092\" data-start=\"6077\">DriverManager</code>, <code data-end=\"6106\" data-start=\"6094\">Connection</code>, <code data-end=\"6127\" data-start=\"6108\">PreparedStatement</code>, <code data-end=\"6140\" data-start=\"6129\">ResultSet</code></td>\n\t\t\t<td data-col-size=\"sm\" data-end=\"6159\" data-start=\"6141\">JDBC Components</td>\n\t\t\t<td data-col-size=\"md\" data-end=\"6234\" data-start=\"6159\">Follow the architecture pipeline: Driver &rarr; Manager &rarr; Statement &rarr; Result</td>\n\t\t</tr>\n\t</tbody>\n</table>\n",
   "COURSE_CODE": "21CSC203P",
   "LEVEL": 3,
   "OUTCOMES": [
    "PLO1",
