   ],
   "QUESTION_DESC": "<p><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Explain Instruction Sequencing in computer architecture with simple examples.</b></span></span></span></p>\n",
   "SESSION_ID": 208,
   "TYPE": "lq",
