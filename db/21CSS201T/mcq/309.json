   "ANSWER": "<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th align=\"center\">Cycle</th>\n\t\t\t<th align=\"center\">Shift A,Q</th>\n\t\t\t<th align=\"center\">A &larr; A &ndash; M?</th>\n\t\t\t<th align=\"center\">MSB of A?</th>\n\t\t\t<th align=\"center\">Q\u2080</th>\n\t\t\t<th align=\"center\">A after restore (if needed)</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td align=\"center\">1</td>\n\t\t\t<td align=\"center\">A=00000&rarr;00000; Q=10101&rarr;01010</td>\n\t\t\t<td align=\"center\">A &ndash; M = 00000&ndash;00011 = 11101\u2082</td>\n\t\t\t<td align=\"center\">MSB=1 (neg)</td>\n\t\t\t<td align=\"center\">Q\u2080=0</td>\n\t\t\t<td align=\"center\">Restore: A&larr;00000</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">2</td>\n\t\t\t<td align=\"center\">A=00000&rarr;00000; Q=01010&rarr;10100</td>\n\t\t\t<td align=\"center\">A &ndash; M = 00000&ndash;00011 = 11101\u2082</td>\n\t\t\t<td align=\"center\">MSB=1</td>\n\t\t\t<td align=\"center\">Q\u2080=0</td>\n\t\t\t<td align=\"center\">Restore: A&larr;00000</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">3</td>\n\t\t\t<td align=\"center\">A=00000&rarr;00000; Q=10100&rarr;01000</td>\n\t\t\t<td align=\"center\">A &ndash; M = 00000&ndash;00011 = 11101\u2082</td>\n\t\t\t<td align=\"center\">MSB=1</td>\n\t\t\t<td align=\"center\">Q\u2080=0</td>\n\t\t\t<td align=\"center\">Restore: A&larr;00000</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">4</td>\n\t\t\t<td align=\"center\">A=00000&rarr;00000; Q=01000&rarr;10000</td>\n\t\t\t<td align=\"center\">A &ndash; M = 00000&ndash;00011 = 11101\u2082</td>\n\t\t\t<td align=\"center\">MSB=1</td>\n\t\t\t<td align=\"center\">Q\u2080=0</td>\n\t\t\t<td align=\"center\">Restore: A&larr;00000</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<p>&nbsp;</p>\n\n<ul>\n\t<li data-end=\"1134\" data-start=\"1077\">\n\t<p data-end=\"1134\" data-start=\"1079\"><strong data-end=\"1095\" data-start=\"1079\">Quotient (Q)</strong> bits after 4 cycles: <strong data-end=\"1126\" data-start=\"1117\">0000\u2082</strong> = 0\u2081\u2080</p>\n\t</li>\n\t<li data-end=\"1172\" data-start=\"1135\">\n\t<p data-end=\"1172\" data-start=\"1137\"><strong data-end=\"1154\" data-start=\"1137\">Remainder (A)</strong>: <strong data-end=\"1166\" data-start=\"1156\">00000\u2082</strong> = 0\u2081\u2080</p>\n\t</li>\n</ul>\n",
