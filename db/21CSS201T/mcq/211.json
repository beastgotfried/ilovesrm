 "sq": [
  {
   "_id": 31975,
   "ANSWER": "<p>8086 is a <strong data-end=\"296\" data-start=\"271\">16-bit microprocessor</strong> with a 16-bit data bus and 20-bit address bus.</p>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
   "QUESTION_DESC": "<h3 data-end=\"253\" data-start=\"192\"><strong data-end=\"251\" data-start=\"196\">What is the word length of 8086 microprocessor?</strong></h3>\n\n<p data-end=\"345\" data-start=\"254\">&nbsp;</p>\n\n<p data-end=\"372\" data-start=\"281\">&nbsp;</p>\n",
   "SESSION_ID": 211,
   "TYPE": "sq",
   "key": 31975
  },
  {
   "_id": 31976,
   "ANSWER": "<p>EU decodes instructions from the BIU and executes them using ALU, control circuits, and registers.</p>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
   "QUESTION_DESC": "<h3 data-end=\"1045\" data-start=\"987\"><strong data-end=\"1043\" data-start=\"991\">What is the role of the Execution Unit (EU)?</strong></h3>\n\n<p data-end=\"345\" data-start=\"254\">&nbsp;</p>\n\n<p data-end=\"372\" data-start=\"281\">&nbsp;</p>\n",
   "SESSION_ID": 211,
   "TYPE": "sq",
   "key": 31976
  }
