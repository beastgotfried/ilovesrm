 "sq": [
  {
   "_id": 25204,
   "ANSWER": "<p><em data-end=\"267\" data-start=\"179\">A (accumulator) = 0, Q = dividend, M = divisor, n = bit-width of dividend</em></p>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
   "QUESTION_DESC": "<p><em data-end=\"176\" data-start=\"73\">What are the main registers and initial values needed to perform single-cycle non\u2011restoring division?</em></p>\n",
   "SESSION_ID": 308,
   "TYPE": "sq",
   "key": 25204
  },
  {
   "_id": 25217,
   "ANSWER": "<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th align=\"center\">Cycle</th>\n\t\t\t<th align=\"center\">A before shift</th>\n\t\t\t<th align=\"center\">Shift (A,Q) &rarr; A</th>\n\t\t\t<th align=\"center\">A op= &plusmn;\u202fM</th>\n\t\t\t<th align=\"center\">Q\u2080</th>\n\t\t\t<th align=\"center\">A after op</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td align=\"center\">1</td>\n\t\t\t<td align=\"center\">00000</td>\n\t\t\t<td align=\"center\">00000</td>\n\t\t\t<td align=\"center\">subtract M &rarr; 11101\u2082</td>\n\t\t\t<td align=\"center\">0</td>\n\t\t\t<td align=\"center\">11101</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">2</td>\n\t\t\t<td align=\"center\">(11101 neg)</td>\n\t\t\t<td align=\"center\">shift &rarr; 1110</td>\n\t\t\t<td align=\"center\">add M &rarr; 1110 + 00011 = 11111\u2082</td>\n\t\t\t<td align=\"center\">0</td>\n\t\t\t<td align=\"center\">11111</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">3</td>\n\t\t\t<td align=\"center\">(11111 neg)</td>\n\t\t\t<td align=\"center\">shift &rarr; 1111</td>\n\t\t\t<td align=\"center\">add M &rarr; 1111 + 0011 = 00010\u2082 (carry out)</td>\n\t\t\t<td align=\"center\">1</td>\n\t\t\t<td align=\"center\">00010</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\">4</td>\n\t\t\t<td align=\"center\">(00010 pos)</td>\n\t\t\t<td align=\"center\">shift &rarr; 0010</td>\n\t\t\t<td align=\"center\">subtract M &rarr; 0010 &minus; 0011 = 11111\u2082 (neg)</td>\n\t\t\t<td align=\"center\">0</td>\n\t\t\t<td align=\"center\">11111</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td align=\"center\"><strong>Final adj.</strong></td>\n\t\t\t<td align=\"center\">A is negative</td>\n\t\t\t<td align=\"center\">&mdash;</td>\n\t\t\t<td align=\"center\">add M &rarr; 11111 + 00011 = 00010\u2082</td>\n\t\t\t<td align=\"center\">&mdash;</td>\n\t\t\t<td align=\"center\"><strong>00010</strong> (positive)</td>\n\t\t</tr>\n\t</tbody>\n</table>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
