    "PLO1"
   ],
   "QUESTION_DESC": "<p><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Explain different addressing modes with suitable examples.</b></span></span></span></p>\n",
