 "sq": [
  {
   "_id": 31982,
   "ANSWER": "<h3 data-end=\"889\" data-start=\"830\">It is the layout of bits in an instruction, defining fields such as <strong data-end=\"364\" data-start=\"302\">opcode, operands, addressing mode, and register specifiers</strong>.</h3>\n\n<p data-end=\"960\" data-start=\"890\">&nbsp;</p>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
   "QUESTION_DESC": "<h3 data-end=\"219\" data-start=\"175\"><strong data-end=\"217\" data-start=\"179\">What is an instruction format?</strong></h3>\n\n<p data-end=\"367\" data-start=\"220\">&nbsp;</p>\n\n<p data-end=\"583\" data-start=\"524\">&nbsp;</p>\n",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 31982
  },
  {
   "_id": 31983,
   "ANSWER": "<ol data-end=\"564\" data-start=\"450\">\n\t<li data-end=\"478\" data-start=\"450\">\n\t<p data-end=\"478\" data-start=\"453\"><strong data-end=\"476\" data-start=\"453\">Zero-address format</strong></p>\n\t</li>\n\t<li data-end=\"506\" data-start=\"479\">\n\t<p data-end=\"506\" data-start=\"482\"><strong data-end=\"504\" data-start=\"482\">One-address format</strong></p>\n\t</li>\n\t<li data-end=\"534\" data-start=\"507\">\n\t<p data-end=\"534\" data-start=\"510\"><strong data-end=\"532\" data-start=\"510\">Two-address format</strong></p>\n\t</li>\n\t<li data-end=\"564\" data-start=\"535\">\n\t<p data-end=\"564\" data-start=\"538\"><strong data-end=\"562\" data-start=\"538\">Three-address format</strong></p>\n\t</li>\n</ol>\n\n<p data-end=\"960\" data-start=\"890\">&nbsp;</p>\n",
   "COURSE_CODE": "21CSS201T",
   "LEVEL": 1,
   "OUTCOMES": [
    "PLO1"
   ],
   "QUESTION_DESC": "<h3 data-end=\"435\" data-start=\"374\"><strong data-end=\"433\" data-start=\"378\">What are the main types of instruction formats?</strong></h3>\n\n<p data-end=\"449\" data-start=\"436\">&nbsp;</p>\n\n<p data-end=\"367\" data-start=\"220\">&nbsp;</p>\n\n<p data-end=\"583\" data-start=\"524\">&nbsp;</p>\n",
   "SESSION_ID": 207,
   "TYPE": "sq",
   "key": 31983
  }
 ],
 "lq": [
  {
   "_id": 31994,
   "ANSWER": "<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>&nbsp;1. Zero Address Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Used in <b>stack-based architectures</b>.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">No explicit operand field &mdash; operations are performed on the <b>top of the stack</b>.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example:</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">PUSH 5&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">PUSH 3&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ; adds top two stack values &rarr; result = 8</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> Arithmetic in stack machines (e.g., JVM).</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b><span style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">\ud83d\udd39</span> 2. One Address Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Contains <b>one explicit operand</b> and assumes an <b>accumulator (ACC)</b> as the second operand.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Suitable for simple machines.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example:</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">LOAD A&nbsp;&nbsp; ; ACC &larr; M[A]&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD B&nbsp;&nbsp;&nbsp; ; ACC &larr; ACC + M[B]&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">STORE C&nbsp; ; M[C] &larr; ACC</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> Early computers (e.g., IBM 7090).</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b><span style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">\ud83d\udd39</span> 3. Two Address Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Contains <b>two explicit operands</b>.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Typically: OP Destination, Source.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">First operand acts as both input and output.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example:</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">MOV R1, A&nbsp;&nbsp; ; R1 &larr; M[A]&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD R1, B&nbsp;&nbsp; ; R1 &larr; R1 + M[B]</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> Common in CISC architectures like x86.</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b><span style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">\ud83d\udd39</span> 4. Three Address Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Contains <b>three explicit operands</b>: two sources and one destination.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Requires more bits, but allows more flexible and faster execution.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example:</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD R1, R2, R3&nbsp;&nbsp; ; R1 &larr; R2 + R3</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> RISC architectures (e.g., MIPS, ARM).</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b><span style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">\ud83d\udd39</span> 5. Variable Length Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Instructions have <b>different sizes</b> depending on operation and addressing mode.</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Saves memory but complicates decoding.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example (x86 ISA):</b></span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">MOV AL, 34H&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ; 2 bytes&nbsp; </span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">MOV EAX, [1000H]&nbsp;&nbsp;&nbsp; ; 5 bytes</span></span></span></p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> Intel x86 processors.</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b><span style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">\ud83d\udd39</span> 6. Fixed Length Instruction Format</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">All instructions have the <b>same size</b> (e.g., 32 bits).</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Easier to fetch and decode in pipeline execution.</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example (MIPS ISA):</b></span></span></span></p>\n\n<ul>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>R-format:</b> ADD R1, R2, R3</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>I-format:</b> LW R1, 100(R2)</span></span></span></span></li>\n\t<li style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"tab-stops:list 36.0pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>J-format:</b> J LABEL</span></span></span></span></li>\n</ul>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Use Case:</b> RISC processors.</span></span></span></p>\n\n<p style=\"margin-bottom:11px\">&nbsp;</p>\n\n<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Summary Table</b></span></span></span></p>\n\n<table class=\"Table\">\n\t<thead>\n\t\t<tr>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Format</b></span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>No. of Explicit Operands</b></span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Example</b></span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><b>Used In</b></span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Zero Address</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">0</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD (stack: TOS1+TOS2)</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Stack machines</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">One Address</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">1</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD B (ACC + M[B])</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">IBM 7090</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Two Address</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">2</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">ADD R1, B</span></span></span></p>\n\t\t\t</td>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">x86 CISC</span></span></span></p>\n\t\t\t</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"padding:.100px .100px .100px .100px\">\n\t\t\t<p style=\"margin-bottom:11px\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Three Address</span><