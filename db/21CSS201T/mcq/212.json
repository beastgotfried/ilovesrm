   ],
   "QUESTION_DESC": "<h3 data-end=\"280\" data-start=\"219\"><strong data-end=\"278\" data-start=\"223\">What is the word length of 8086 microprocessor?</strong></h3>\n\n<p data-end=\"372\" data-start=\"281\">&nbsp;</p>\n",
