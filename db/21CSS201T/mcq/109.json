   "key": 21823
  },
  {
   "_id": 21871,
   "ANSWER": "<ul data-end=\"1574\" data-start=\"380\">\n\t<li data-end=\"651\" data-start=\"380\">\n\t<p data-end=\"1799\" data-start=\"1636\">This expression uses:</p>\n\t</li>\n\t<li data-end=\"1832\" data-start=\"1800\">\n\t<p data-end=\"1832\" data-start=\"1802\"><strong data-end=\"1814\" data-start=\"1802\">AND gate</strong> for A&sdot;B</p>\n\t</li>\n\t<li data-end=\"1862\" data-start=\"1833\">\n\t<p data-end=\"1862\" data-start=\"1835\"><strong data-end=\"1847\" data-start=\"1835\">NOT gate</strong> for &not;C</p>\n\t</li>\n\t<li data-end=\"1927\" data-start=\"1863\">\n\t<p data-end=\"1927\" data-start=\"1865\"><strong data-end=\"1876\" data-start=\"1865\">OR gate</strong> to combine the outputs of A&sdot;B and &not;C</p>\n\t</li>\n\t<li data-end=\"651\" data-start=\"380\">\n\t<table>\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<td>\n\t\t\t\t<p data-end=\"2224\" data-start=\"2155\"><strong data-end=\"1960\" data-start=\"1929\">Steps to construct circuit:</strong></p>\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n\t</li>\n\t<li data-end=\"2021\" data-start=\"1961\">\n\t<p data-end=\"2021\" data-start=\"1964\">Connect inputs A and B to an AND gate &rarr; output1 = A &middot; B</p>\n\t</li>\n\t<li data-end=\"2071\" data-start=\"2022\">\n\t<p data-end=\"2071\" data-start=\"2025\">Connect input C to a NOT gate &rarr; output2 = &not;C</p>\n\t</li>\n\t<li data-end=\"2118\" data-start=\"2072\">\n\t<p data-end=\"2118\" data-start=\"2075\">Connect output1 and output2 to an OR gate</p>\n\t</li>\n\t<li data-end=\"2153\" data-start=\"2119\">\n\t<p data-end=\"2153\" data-start=\"2122\">Final output Y = (A &middot; B) + (&not;C)</p>\n\t</li>\n\t<li data-end=\"651\" data-start=\"380\">\n\t<table>\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<td>\n\t\t\t\t<p data-end=\"1960\" data-start=\"1929\">This circuit gives output 1 if either A AND B is true, or C is false.</p>\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t</tbody>\n\t</table>\n\n\t<p data-end=\"1077\" data-start=\"1061\">&nbsp;</p>\n\t</li>\n</ul>\n\n<hr data-end=\"1579\" data-start=\"1576\" />",
