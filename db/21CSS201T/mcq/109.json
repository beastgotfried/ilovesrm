   "ANSWER": "<ul>\n\t<li data-end=\"2050\" data-start=\"1986\">\n\t<p data-end=\"2050\" data-start=\"1988\"><strong data-end=\"2009\" data-start=\"1988\">Given Expression:</strong><br data-end=\"2012\" data-start=\"2009\" />\n\tY=(A+B)&sdot;C</p>\n\t</li>\n\t<li data-end=\"2275\" data-start=\"2052\">\n\t<p data-end=\"2071\" data-start=\"2054\"><strong data-end=\"2071\" data-start=\"2054\">Design Steps:</strong></p>\n\n\t<ol data-end=\"2275\" data-start=\"2074\">\n\t\t<li data-end=\"2137\" data-start=\"2074\">\n\t\t<p data-end=\"2137\" data-start=\"2077\">Connect inputs A and B to an <strong data-end=\"2117\" data-start=\"2106\">OR gate</strong> &rarr; output1 = A + B</p>\n\t\t</li>\n\t\t<li data-end=\"2193\" data-start=\"2140\">\n\t\t<p data-end=\"2193\" data-start=\"2143\">Connect input C to a <strong data-end=\"2176\" data-start=\"2164\">NOT gate</strong> &rarr; output2 = &not;C</p>\n\t\t</li>\n\t\t<li data-end=\"2275\" data-start=\"2196\">\n\t\t<p data-end=\"2275\" data-start=\"2199\">Connect output1 and output2 to an <strong data-end=\"2245\" data-start=\"2233\">AND gate</strong> &rarr; final output = (A + B) &middot; &not;C</p>\n\t\t</li>\n\t</ol>\n\t</li>\n\t<li data-end=\"2725\" data-start=\"2277\">\n\t<p data-end=\"2295\" data-start=\"2279\"><strong data-end=\"2295\" data-start=\"2279\">Truth Table:</strong></p>\n\n\t<table data-end=\"2725\" data-start=\"2299\">\n\t\t<thead data-end=\"2338\" data-start=\"2299\">\n\t\t\t<tr data-end=\"2338\" data-start=\"2299\">\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2303\" data-start=\"2299\" style=\"text-align: center;\">A</th>\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2307\" data-start=\"2303\" style=\"text-align: center;\">B</th>\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2311\" data-start=\"2307\" style=\"text-align: center;\">C</th>\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2317\" data-start=\"2311\" style=\"text-align: center;\">A+B</th>\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2322\" data-start=\"2317\" style=\"text-align: center;\">&not;C</th>\n\t\t\t\t<th data-col-size=\"sm\" data-end=\"2338\" data-start=\"2322\" style=\"text-align: center;\">Y = (A+B)&middot;&not;C</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody data-end=\"2725\" data-start=\"2384\">\n\t\t\t<tr data-end=\"2424\" data-start=\"2384\">\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2388\" data-start=\"2384\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2392\" data-start=\"2388\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2396\" data-start=\"2392\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2402\" data-start=\"2396\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2407\" data-start=\"2402\" style=\"text-align: center;\">1</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2424\" data-start=\"2407\" style=\"text-align: center;\">0</td>\n\t\t\t</tr>\n\t\t\t<tr data-end=\"2467\" data-start=\"2427\">\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2431\" data-start=\"2427\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2435\" data-start=\"2431\" style=\"text-align: center;\">1</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2439\" data-start=\"2435\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2445\" data-start=\"2439\" style=\"text-align: center;\">1</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2450\" data-start=\"2445\" style=\"text-align: center;\">1</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2467\" data-start=\"2450\" style=\"text-align: center;\">1</td>\n\t\t\t</tr>\n\t\t\t<tr data-end=\"2510\" data-start=\"2470\">\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2474\" data-start=\"2470\" style=\"text-align: center;\">1</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end=\"2478\" data-start=\"2474\" style=\"text-align: center;\">0</td>\n\t\t\t\t<td data-col-size=\"sm\" data-end