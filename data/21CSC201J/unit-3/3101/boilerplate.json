{
 "title": "Unit – 3 : Session – 10 : SLO – 1  |  Implementation of Queue Using Array — Code",
 "sections": [
  [
   "I. Declaration and Initialisation",
   [
    "#define MAX 100",
    "int queue[MAX];",
    "int front = -1, rear = -1;"
   ]
  ],
  [
   "II. Enqueue Function",
   [
    "void enqueue(int val) {",
    "    if (rear == MAX - 1) { printf(\"OVERFLOW\\n\"); return; }",
    "    if (front == -1) front = 0;",
    "    queue[++rear] = val;",
    "}"
   ]
  ],
  [
   "III. Dequeue Function",
   [
    "int dequeue() {",
    "    if (front == -1 || front > rear) { printf(\"UNDERFLOW\\n\"); return -1; }",
    "    int val = queue[front++];",
    "    if (front > rear) { front = rear = -1; }",
    "    return val;",
    "}"
   ]
  ]
 ]
}
