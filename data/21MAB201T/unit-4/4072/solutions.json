 "sq": [
  {
   "q": "\\(\\text{Find the Fourier cosine transform of } f(x) = \\frac{1}{x^2+a^2}.\\)",
   "answer": [
    "\\(\\text{We know } F_c[e^{-ax}] = \\sqrt{\\frac{2}{\\pi}} \\frac{a}{a^2+s^2}\\)",
    "\\(\\text{By inverse cosine transform: } e^{-ax} = \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} F_c(s) \\cos(sx) ds\\)",
    "\\(= \\frac{2a}{\\pi} \\int_{0}^{\\infty} \\frac{1}{a^2+s^2} \\cos(sx) ds\\)",
    "\\(\\text{Interchange x and s: } \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} \\frac{1}{x^2+a^2} \\cos(sx) dx = \\sqrt{\\frac{\\pi}{2}} \\frac{e^{-as}}{a}\\)",
    "\\(\\text{Hence } F_c\\left[\\frac{1}{x^2+a^2}\\right] = \\sqrt{\\frac{\\pi}{2}} \\frac{e^{-as}}{a}.\\)"
   ]
  },
  {
   "q": "\\(\\text{Find the Fourier sine transform of } f(x) = \\frac{x}{x^2+a^2}.\\)",
   "answer": [
    "\\(\\text{We know } F_s[e^{-ax}] = \\sqrt{\\frac{2}{\\pi}} \\frac{s}{s^2+a^2}\\)",
    "\\(\\text{By inverse sine transform: } e^{-ax} = \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} F_s(s) \\sin(sx) ds\\)",
    "\\(= \\frac{2}{\\pi} \\int_{0}^{\\infty} \\frac{s}{s^2+a^2} \\sin(sx) ds\\)",
    "\\(\\text{Interchange x and s: } \\sqrt{\\frac{2}{\\pi}} \\int_{0}^{\\infty} \\frac{x}{x^2+a^2} \\sin(sx) dx = \\sqrt{\\frac{\\pi}{2}} e^{-as}\\)",
    "\\(\\text{Hence } F_s\\left[\\frac{x}{x^2+a^2}\\right] = \\sqrt{\\frac{\\pi}{2}} e^{-as}.\\)"
   ]
  }
 ],
